{
  "manifest_version": 3,
  "name": "Morph",
  "version": "1.0.0",
  "description": "Animated profile pictures for X",
  "permissions": [
    "storage",
    "identity"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://*.supabase.co/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*"],
      "js": ["supabase-client.js", "content.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["supabase-client.js"],
      "matches": ["https://x.com/*"]
    }
  ]
}